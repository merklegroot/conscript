<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Conscript</RootNamespace>
    <ApplicationIcon>..\assets\icons\conscript.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <!-- Background images (and future scene art) are embedded resources -->
  <ItemGroup>
    <EmbeddedResource Include="img/**/*" />
  </ItemGroup>

  <!-- Fonts remain loose files in output (easy to hot-swap during development) -->
  <ItemGroup>
    <None Include="Fonts\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
